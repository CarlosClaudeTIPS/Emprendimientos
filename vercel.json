{
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": ".*\\.vercel\\.app"
        }
      ],
      "destination": "https://nivytek.com/icfes/",
      "permanent": true
    },
    {
      "source": "/:path(.*)",
      "has": [
        {
          "type": "host",
          "value": ".*\\.vercel\\.app"
        }
      ],
      "destination": "https://nivytek.com/:path",
      "permanent": true
    },
    {
      "source": "/tienda",
      "has": [
        {
          "type": "host",
          "value": "nivytek\\.com"
        }
      ],
      "destination": "https://tienda.nivytek.com/",
      "permanent": true
    },
    {
      "source": "/tienda/",
      "has": [
        {
          "type": "host",
          "value": "nivytek\\.com"
        }
      ],
      "destination": "https://tienda.nivytek.com/",
      "permanent": true
    },
    {
      "source": "/tienda/:path(.*)",
      "has": [
        {
          "type": "host",
          "value": "nivytek\\.com"
        }
      ],
      "destination": "https://tienda.nivytek.com/:path",
      "permanent": true
    },
    {
      "source": "/docentes",
      "destination": "/docentes/",
      "permanent": true
    },
    {
      "source": "/icfes",
      "destination": "/icfes/",
      "permanent": true
    },
    {
      "source": "/portal",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/portal/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/portal/:path*/",
      "destination": "/:path*/",
      "permanent": true
    },
    {
      "source": "/portal/:path*",
      "destination": "/:path*",
      "permanent": true
    },
    {
      "source": "/producto.html",
      "has": [
        {
          "type": "query",
          "key": "p",
          "value": "control-xbox-forza-horizon-6"
        }
      ],
      "destination": "/p/control-xbox-forza-horizon-6.html",
      "permanent": true
    },
    {
      "source": "/producto.html",
      "has": [
        {
          "type": "query",
          "key": "p",
          "value": "control-xbox-robot-white"
        }
      ],
      "destination": "/p/control-xbox-robot-white.html",
      "permanent": true
    },
    {
      "source": "/producto.html",
      "has": [
        {
          "type": "query",
          "key": "p",
          "value": "rastreadores-flyruit-tag-x4"
        }
      ],
      "destination": "/p/rastreadores-flyruit-tag-x4.html",
      "permanent": true
    },
    {
      "source": "/producto.html",
      "has": [
        {
          "type": "query",
          "key": "p",
          "value": "ya-cargador-usbc-20w"
        }
      ],
      "destination": "/p/cargador-stuffcool-usb-c-20w-iphone.html",
      "permanent": true
    },
    {
      "source": "/producto.html",
      "has": [
        {
          "type": "query",
          "key": "p",
          "value": "ya-camara-yoton-2k"
        }
      ],
      "destination": "/p/camara-seguridad-yoton-2k-wifi.html",
      "permanent": true
    },
    {
      "source": "/producto.html",
      "has": [
        {
          "type": "query",
          "key": "p",
          "value": "ya-medicube-vitamina-c"
        }
      ],
      "destination": "/p/medicube-crema-capsula-vitamina-c.html",
      "permanent": true
    },
    {
      "source": "/producto.html",
      "has": [
        {
          "type": "query",
          "key": "p",
          "value": "ya-medicube-azelaico"
        }
      ],
      "destination": "/p/medicube-exosome-shot-acido-azelaico.html",
      "permanent": true
    },
    {
      "source": "/producto.html",
      "has": [
        {
          "type": "query",
          "key": "p",
          "value": "ya-medicube-exosome-poros"
        }
      ],
      "destination": "/p/medicube-exosome-shot-zero-poros.html",
      "permanent": true
    },
    {
      "source": "/producto.html",
      "has": [
        {
          "type": "query",
          "key": "p",
          "value": "ya-cerave-pm"
        }
      ],
      "destination": "/p/cerave-pm-locion-noche.html",
      "permanent": true
    },
    {
      "source": "/producto.html",
      "has": [
        {
          "type": "query",
          "key": "p",
          "value": "ya-cerave-protector-mineral"
        }
      ],
      "destination": "/p/cerave-protector-solar-mineral-spf30.html",
      "permanent": true
    },
    {
      "source": "/producto.html",
      "has": [
        {
          "type": "query",
          "key": "p",
          "value": "ya-cetaphil-limpiador"
        }
      ],
      "destination": "/p/cetaphil-limpiador-facial-473ml.html",
      "permanent": true
    },
    {
      "source": "/producto.html",
      "has": [
        {
          "type": "query",
          "key": "p",
          "value": "ya-nivea-locion"
        }
      ],
      "destination": "/p/nivea-locion-corporal-piel-seca.html",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "tienda\\.nivytek\\.com"
        }
      ],
      "destination": "/tienda/index.html"
    },
    {
      "source": "/index.html",
      "has": [
        {
          "type": "host",
          "value": "tienda\\.nivytek\\.com"
        }
      ],
      "destination": "/tienda/index.html"
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "tienda\\.nivytek\\.com"
        }
      ],
      "destination": "/tienda/:path*"
    },
    {
      "source": "/icfes/:path((?!.*\\.).*)",
      "destination": "/icfes/index.html"
    }
  ],
  "functions": {
    "api/estudiantes.js": {
      "maxDuration": 30
    },
    "api/pin.js": {
      "maxDuration": 30
    }
  },
  "headers": [
    {
      "source": "/((?!api/).*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://nivytek.com https://www.googletagmanager.com https://connect.facebook.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://nivytek.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https:; media-src 'self' https:; connect-src 'self' https://nivytek.com https://docs.google.com https://*.googleusercontent.com https://*.supabase.co https://www.google-analytics.com https://*.google-analytics.com https://*.analytics.google.com https://www.facebook.com https://api.anthropic.com; frame-ancestors 'self'; base-uri 'self'; form-action 'self' https://formspree.io; upgrade-insecure-requests"
        }
      ]
    }
  ]
}
