{
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": ".*\\.vercel\\.app"
        }
      ],
      "destination": "https://nivytek.com/icfes/",
      "permanent": true
    },
    {
      "source": "/:path(.*)",
      "has": [
        {
          "type": "host",
          "value": ".*\\.vercel\\.app"
        }
      ],
      "destination": "https://nivytek.com/:path",
      "permanent": true
    },
    {
      "source": "/tienda",
      "has": [
        {
          "type": "host",
          "value": "nivytek\\.com"
        }
      ],
      "destination": "https://tienda.nivytek.com/",
      "permanent": true
    },
    {
      "source": "/tienda/",
      "has": [
        {
          "type": "host",
          "value": "nivytek\\.com"
        }
      ],
      "destination": "https://tienda.nivytek.com/",
      "permanent": true
    },
    {
      "source": "/tienda/:path(.*)",
      "has": [
        {
          "type": "host",
          "value": "nivytek\\.com"
        }
      ],
      "destination": "https://tienda.nivytek.com/:path",
      "permanent": true
    },
    {
      "source": "/docentes",
      "destination": "/docentes/",
      "permanent": true
    },
    {
      "source": "/icfes",
      "destination": "/icfes/",
      "permanent": true
    },
    {
      "source": "/portal",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/portal/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/portal/:path*/",
      "destination": "/:path*/",
      "permanent": true
    },
    {
      "source": "/portal/:path*",
      "destination": "/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "tienda\\.nivytek\\.com"
        }
      ],
      "destination": "/tienda/index.html"
    },
    {
      "source": "/index.html",
      "has": [
        {
          "type": "host",
          "value": "tienda\\.nivytek\\.com"
        }
      ],
      "destination": "/tienda/index.html"
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "tienda\\.nivytek\\.com"
        }
      ],
      "destination": "/tienda/:path*"
    },
    {
      "source": "/icfes/:path((?!.*\\.).*)",
      "destination": "/icfes/index.html"
    }
  ],
  "functions": {
    "api/estudiantes.js": {
      "maxDuration": 30
    },
    "api/pin.js": {
      "maxDuration": 30
    }
  },
  "headers": [
    {
      "source": "/((?!api/).*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://nivytek.com https://www.googletagmanager.com https://connect.facebook.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://nivytek.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https:; media-src 'self' https:; connect-src 'self' https://nivytek.com https://*.supabase.co https://www.google-analytics.com https://*.google-analytics.com https://*.analytics.google.com https://www.facebook.com https://api.anthropic.com; frame-ancestors 'self'; base-uri 'self'; form-action 'self' https://formspree.io; upgrade-insecure-requests"
        }
      ]
    }
  ]
}
